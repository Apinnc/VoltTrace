<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API < 31.
   VoltTrace keeps all battery telemetry, app-usage history, and preferences strictly on-device.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
